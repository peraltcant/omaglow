#!/bin/sh
# The VERSION file is the version; both PKGBUILDs must say the same.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
version="$(tr -d '[:space:]' < "$ROOT/VERSION")"

for pkgbuild in pkgbuild/PKGBUILD aur/PKGBUILD; do
    pkgver="$(sed -n 's/^pkgver=//p' "$ROOT/$pkgbuild")"
    if [ "$version" != "$pkgver" ]; then
        echo "VERSION says $version but $pkgbuild says pkgver=$pkgver" >&2
        exit 1
    fi
done
echo "Version $version"
